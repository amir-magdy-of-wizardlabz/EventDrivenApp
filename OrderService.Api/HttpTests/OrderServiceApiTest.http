# Create a new order (the user must exist; an unknown user returns 422)
POST http://localhost:5002/api/orders
Content-Type: application/json

{
  "userId": 1,
  "productName": "Laptop",
  "quantity": 1,
  "price": 1500.00
}

###

# Get all orders
GET http://localhost:5002/api/orders

###

# Get a specific order by ID
GET http://localhost:5002/api/orders/1

###

# Update an order
PUT http://localhost:5002/api/orders/1
Content-Type: application/json

{
  "productName": "Laptop",
  "quantity": 2,
  "price": 3000.00
}

###

# Delete an order
DELETE http://localhost:5002/api/orders/1
